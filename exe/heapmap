#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "heapmap/cli"

$stdin.binmode
$stdout.binmode
$stderr.binmode
args = ARGV.map { |word| word.dup.force_encoding(Encoding::BINARY) }
input = Heapmap::Cli.reads_stdin?(args) ? $stdin.read : ""
reply = Heapmap::Cli.run(args, input)
$stdout.write(reply[:out])
$stderr.write(reply[:err])
exit(reply[:status])
